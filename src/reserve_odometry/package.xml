<?xml version="1.0"?>
<package format="3">
 <name>reserve_odometry</name><version>0.4.0</version>
 <description>Causal model-based tram reserve odometry with a directed rail map and rigid-body geometry.</description>
 <maintainer email="maintainer@example.com">Competition team</maintainer>
 <license>Apache-2.0</license>
 <buildtool_depend>ament_cmake</buildtool_depend>
 <depend>rclcpp</depend><depend>tram_vehicle_msgs</depend><depend>nav_msgs</depend><depend>std_msgs</depend>
 <depend>sensor_msgs</depend>
 <exec_depend>ament_index_python</exec_depend>
 <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
 <export><build_type>ament_cmake</build_type></export>
</package>
